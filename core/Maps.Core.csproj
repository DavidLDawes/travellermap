<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Portable core: sector data model, parsing/serialization, astrometrics, validation, and
    rendering (SVG; bitmaps via SkiaSharp and PDF via PDFsharp, both with the fonts bundled in
    res/fonts).
    No System.Web or Windows-only System.Drawing. Built for .NET Framework 4.8 (used by
    the current IIS site, Maps.csproj) and .NET 10 (future cross-platform host and tools).
    Source files stay in server/ (linked here) so upstream changes still apply.
  -->
  <PropertyGroup>
    <!-- Visual Studio / msbuild.exe (used for the IIS site) builds net48 only, so it needs no
         .NET 10 SDK; `dotnet build` (SDK 10+) builds both. -->
    <TargetFrameworks Condition="'$(MSBuildRuntimeType)' == 'Core'">net48;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(MSBuildRuntimeType)' != 'Core'">net48</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Maps</RootNamespace>
    <AssemblyName>Maps.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Util.MapPath uses HostingEnvironment when running under IIS. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Configuration" />
  </ItemGroup>
  <ItemGroup>
    <!-- The IIS site, tests, and tools use the core's internal types. -->
    <InternalsVisibleTo Include="Maps" />
    <InternalsVisibleTo Include="UnitTests" />
    <InternalsVisibleTo Include="maps-validate" />
    <InternalsVisibleTo Include="Maps.Host" />
  </ItemGroup>
  <ItemGroup>
    <!-- Includes native libraries for Windows and macOS; a Linux app adds
         SkiaSharp.NativeAssets.Linux.NoDependencies. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <!-- The core (cross-platform) build of PDFsharp, not PDFsharp-GDI. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../server/Astrometrics.cs" Link="server/Astrometrics.cs" />
    <Compile Include="../server/Geometry.cs" Link="server/Geometry.cs" />
    <Compile Include="../server/Location.cs" Link="server/Location.cs" />
    <Compile Include="../server/Metadata.cs" Link="server/Metadata.cs" />
    <Compile Include="../server/Sector.cs" Link="server/Sector.cs" />
    <Compile Include="../server/SectorMap.cs" Link="server/SectorMap.cs" />
    <Compile Include="../server/SectorStylesheet.cs" Link="server/SectorStylesheet.cs" />
    <Compile Include="../server/SecondSurvey.cs" Link="server/SecondSurvey.cs" />
    <Compile Include="../server/StellarData.cs" Link="server/StellarData.cs" />
    <Compile Include="../server/World.cs" Link="server/World.cs" />
    <Compile Include="../server/WorldCollection.cs" Link="server/WorldCollection.cs" />
    <Compile Include="../server/Selector.cs" Link="server/Selector.cs" />
    <Compile Include="../server/ResourceManager.cs" Link="server/ResourceManager.cs" />
    <Compile Include="../server/serialization/*.cs" LinkBase="server/serialization" />
    <Compile Include="../server/utilities/*.cs" LinkBase="server/utilities" />
    <Compile Include="../server/admin/*.cs" LinkBase="server/admin" />
    <!-- Request handlers, routes and the host-neutral HTTP layer (server/http/HttpAbstractions.cs). -->
    <Compile Include="../server/HandlerBase.cs" Link="server/HandlerBase.cs" />
    <Compile Include="../server/api/*.cs" LinkBase="server/api" />
    <Compile Include="../server/http/HttpAbstractions.cs" Link="server/http/HttpAbstractions.cs" />
    <Compile Include="../server/http/Routing.cs" Link="server/http/Routing.cs" />
    <Compile Include="../server/search/SearchResult.cs" Link="server/search/SearchResult.cs" />
    <Compile Include="../server/search/SearchIndex.cs" Link="server/search/SearchIndex.cs" />
    <Compile Include="../server/RenderContext.cs" Link="server/RenderContext.cs" />
    <Compile Include="../server/RenderUtil.cs" Link="server/RenderUtil.cs" />
    <Compile Include="../server/Stylesheet.cs" Link="server/Stylesheet.cs" />
    <Compile Include="../server/VectorObject.cs" Link="server/VectorObject.cs" />
    <Compile Include="../server/graphics/AbstractGraphics.cs" Link="server/graphics/AbstractGraphics.cs" />
    <Compile Include="../server/graphics/SVGGraphics.cs" Link="server/graphics/SVGGraphics.cs" />
    <Compile Include="../server/graphics/SkiaFonts.cs" Link="server/graphics/SkiaFonts.cs" />
    <Compile Include="../server/graphics/SkiaGraphics.cs" Link="server/graphics/SkiaGraphics.cs" />
    <Compile Include="../server/graphics/PdfSharpGraphics.cs" Link="server/graphics/PdfSharpGraphics.cs" />
  </ItemGroup>
</Project>
